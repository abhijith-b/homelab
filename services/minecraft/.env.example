FORCE_GAMEMODE=false
GENERATE_STRUCTURES=true
HARDCORE=false
MAX_BUILD_HEIGHT=320
MAX_WORLD_SIZE=29999984
PVP=true
SPAWN_ANIMALS=true
SPAWN_MONSTERS=true
SPAWN_NPCS=true
VIEW_DISTANCE=10
SEED=

# Admin console access (podman exec minecraft rcon-cli <command>)
ENABLE_RCON=true
